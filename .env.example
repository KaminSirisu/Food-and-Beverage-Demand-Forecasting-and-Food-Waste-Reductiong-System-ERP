# Neon → your project → Connect. Pooled string (host has "-pooler") for the app:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/freshwaste?sslmode=require"
# Same, without "-pooler" — Prisma uses it for db push:
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/freshwaste?sslmode=require"
INGEST_API_KEY="change-me"   # Power Automate sends this in the x-api-key header

SESSION_SECRET="generate with: openssl rand -base64 32"   # signs the login cookie
APP_URL="http://localhost:3000"                          # base URL printed by prisma/invite.ts